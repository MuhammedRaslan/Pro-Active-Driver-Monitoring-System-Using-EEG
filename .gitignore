# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
# `build/` above targets Python build artefacts, but it also swallows
# submission_compact/build/, which holds the Fig. 5 generator -- source, not
# output. Re-include the directory itself; git cannot re-include a file whose
# parent directory is still excluded.
!submission_compact/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data files (large EEG datasets)
*.edf
*.set
*.fdt
*.mat
DROZY/
SADT/
SEED-VIG/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.bak

# Generated PDFs (optional - uncomment if you want to include PDFs)
*.pdf

# ...except the manuscript's figures. Since 2026-08-06 these are vector PDFs and
# main.tex includes them by name, so they are source, not output: a snapshot
# without them cannot rebuild the paper, and the Reproducibility section names
# the paper-submission-v1 tag explicitly.
!submission_compact/figures/*.pdf

# Cached feature matrices — regeneratable from DROZY_O1_O2/ + SEED-VIG/ via reproduce.py
*.npz

# Packaged submission/Overleaf archives — repackaged copies of tracked files
*.zip

# Review bundle for co-authors: every byte of it is copied from
# submission_ready/ by build_professor_bundle.py, so tracking it would just
# duplicate the package and let the two drift apart.
submission_professor/

# Claude Code workspace & Streamlit local state (not source)
.claude/
.streamlit/
revision/*.zip
